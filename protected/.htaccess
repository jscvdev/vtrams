# Disable directory listing; show custom error pages instead of Apache defaults.
# Paths are from the server document root (htdocs). Change /vtrams if the app base differs.

Options -Indexes

ErrorDocument 403 /vtrams/protected/routes/403.php
ErrorDocument 404 /vtrams/protected/routes/404.php

#AuthType Basic
#AuthName "Restricted Area"
#AuthUserFile /path/to/.htpasswd
#Require valid-user

#Order Allow,Deny
#Deny from all
