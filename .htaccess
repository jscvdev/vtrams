#disable listing
Options -indexes

# Custom error pages for directory browsing and missing paths.
# Paths are from the server document root (htdocs). Change /vtrams if the app base differs.
ErrorDocument 403 /vtrams/protected/routes/403.php
ErrorDocument 404 /vtrams/protected/routes/404.php

#set default page
DirectoryIndex public/documents/index.php

#white listing

#file protection
<FilesMatch "\.(conf|ini|log)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

#avoid malicious scripts
#Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://trusted.com; style-src 'self' 'unsafe-inline' https://trusted.com; img-src 'self' https://trusted.com; connect-src 'self' https://api.trusted.com"
